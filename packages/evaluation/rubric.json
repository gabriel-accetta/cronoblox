{
  "version": 1,
  "primary_metric": "Evidence-Grounded Analysis Quality",
  "human_review_required": true,
  "dimensions": [
    { "id": "quantitative_signals", "label": "Important current quantitative signals", "max": 5, "score": null },
    { "id": "external_context", "label": "Relevant external context and defensible comparables", "max": 5, "score": null },
    { "id": "epistemic_labels", "label": "Facts separated from inference", "max": 5, "score": null },
    { "id": "evidence_links", "label": "Material claims link to evidence", "max": 5, "score": null },
    { "id": "counterevidence", "label": "Uncertainty and counterevidence", "max": 5, "score": null },
    { "id": "recommendation", "label": "Useful and proportionate recommendation", "max": 5, "score": null }
  ],
  "secondary_metrics": ["unsupported_claims", "evidence_coverage", "human_review_time", "runtime_ms", "estimated_cost_usd", "provider_failures"]
}
