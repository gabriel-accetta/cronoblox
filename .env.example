DATABASE_URL=postgresql://cronoblox:cronoblox@localhost:5434/cronoblox
REDIS_URL=redis://localhost:6381
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_SITE_URL=http://localhost:3017
# YouTube search runs through the yt-dlp CLI (no API key/quota) — install it on the machine
# running the worker: `pip install -U yt-dlp`. Override the binary path with YT_DLP_PATH if needed.
# There is no general web-search tool — see packages/modules/market-intelligence.
WORKER_CONCURRENCY=2

# Per-run ceilings. All optional — these are the defaults. They are snapshotted into each run when
# it is created, so changing them never affects a run that is already queued.
# max_cost_usd is the hard wallet guard: effort can lower it, nothing raises it.
CRONOBLOX_MAX_COST_USD=0.20
CRONOBLOX_MAX_EXTERNAL_CALLS=18
CRONOBLOX_MAX_ITERATIONS=8
CRONOBLOX_MAX_CRITIC_CYCLES=2
CRONOBLOX_MAX_RUNTIME_MS=600000
# How many results one search keeps. Low effort scales this down, high effort up.
CRONOBLOX_MAX_SEARCH_RESULTS=8
