DATABASE_URL=postgresql://cronoblox:cronoblox@localhost:5434/cronoblox
REDIS_URL=redis://localhost:6381
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_SITE_URL=http://localhost:3017
# YouTube search runs through the yt-dlp CLI (no API key/quota) — install it on the machine
# running the worker: `pip install -U yt-dlp`. Override the binary path with YT_DLP_PATH if needed.
# There is no general web-search tool — see packages/modules/market-intelligence.
WORKER_CONCURRENCY=2
