    "views": [
      {
        "id": "request-path",
        "label": "Request path",
        "focus": [
          "user",
          "web",
          "queue",
          "engine",
          "postgres"
        ],
        "note": "One public game URL becomes a persisted run: validate, enqueue, execute in the worker, poll state back out of Postgres."
      },
      {
        "id": "fixed-pipeline",
        "label": "Fixed pipeline, chosen by code",
        "focus": [
          "engine",
          "roblox-data",
          "orchestrator",
          "critic"
        ],
        "note": "A persisted state machine picks the top-level steps. No model can skip the mandatory data audit."
      },
      {
        "id": "delegation",
        "label": "Delegation and sources",
        "focus": [
          "orchestrator",
          "data-agent",
          "market-intelligence",
          "providers"
        ],
        "note": "The orchestrator may call two sub-agents as tools; every tool call that returns real data writes an evidence record."
      },
      {
        "id": "verification",
        "label": "Verification and the gate",
        "focus": [
          "critic",
          "engine",
          "gate",
          "postgres"
        ],
        "note": "The critic may hold or lower the rating, never raise it. FINALIZE refuses any report citing evidence that does not exist."
      }
    ]
