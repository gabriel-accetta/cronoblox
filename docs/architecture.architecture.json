  "cards": [
    {
      "dot": "cyan",
      "title": "Request path",
      "items": [
        "POST /api/runs validates input and snapshots an immutable profile onto the run",
        "BullMQ is queue infrastructure only; Postgres holds all durable state",
        "A finished run keeps its full agent trace at ?view=trajectory"
      ]
    },
    {
      "dot": "emerald",
      "title": "Orchestration is code, not a model",
      "items": [
        "A persisted state machine runs modules in a hardcoded order",
        "roblox-data always runs first and cannot be skipped",
        "The model plans only within a step, and may call two sub-agents as tools"
      ]
    },
    {
      "dot": "rose",
      "title": "What the pipeline refuses to do",
      "items": [
        "The critic may hold or lower the rating, never raise it",
        "keepKnownIds strips any cited id that has no persisted record",
        "assertReportEvidence throws rather than ship an unbacked claim"
      ]
    }
  ]
